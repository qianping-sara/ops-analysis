# Azure Foundry (Claude)
# ENDPOINT: use .../anthropic/v1/messages for direct HTTP; SDK normalizes to .../anthropic
CLAUDE_AZURE_API_KEY=
CLAUDE_AZURE_FOUNDRY_ENDPOINT=
CLAUDE_AZURE_FOUNDRY_MODEL=claude-sonnet-4-6

# Analysis target DB (read-only MCP) — odi_knowledge_ai
POSTGRES_URL=postgresql://readonly_user:password@host/odi_knowledge_ai?sslmode=require

# Platform DB (chats, messages, audit)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Platform Redis (short-term memory)
REDIS_URL=redis://default:password@host:port

# SQL guardrails (analysis MCP)
SQL_MAX_ROWS=10000
SQL_STATEMENT_TIMEOUT_MS=30000
SQL_MAX_RESULT_BYTES=2097152

# Prompt caching global toggle (Profile can override)
PROMPT_CACHING_ENABLED=true
